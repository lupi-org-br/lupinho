FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    make \
    gcc-mingw-w64-x86-64 \
    libz-mingw-w64-dev \
    patch \
    zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /lupinho
COPY . /lupinho/
# src/Makefile's default target guesses Linux and adds -DLUA_USE_LINUX.
# Build the library directly so MinGW gets a static liblua.a + lua.exe
# (_WIN32 selects LUA_USE_WINDOWS).
RUN make -C /lupinho/src/libs/linux/lua-5.5.0/src all \
      CC=x86_64-w64-mingw32-gcc \
      AR="x86_64-w64-mingw32-ar rc" \
      RANLIB=x86_64-w64-mingw32-ranlib \
      MYCFLAGS="-std=c99" \
      MYLDFLAGS="" \
      MYLIBS="" \
      LUA_T=lua.exe
ENV PATH=$PATH:/lupinho/src/libs/linux/lua-5.5.0/src
RUN make -C /lupinho/src windows
