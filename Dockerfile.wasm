FROM emscripten/emsdk:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    git \
    ninja-build \
    patch \
    pkg-config \
    python3 \
    zip \
    && rm -rf /var/lib/apt/lists/*

COPY src/music/fetch_furnace.sh /tmp/fetch_furnace.sh
RUN sh /tmp/fetch_furnace.sh /furnace

WORKDIR /lupinho
COPY . /lupinho/
# Install Lua 5.5.0
RUN make -C /lupinho/src/libs/linux/lua-5.5.0 linux
ENV PATH=$PATH:/lupinho/src/libs/linux/lua-5.5.0/src
RUN make -C /lupinho/src web
